        app:layout_constraintGuide_percent="0.29" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline153"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.39" />

    <Switch
        android:id="@+id/notificationsetting_booking_success"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/NS_booking_success"
        app:layout_constraintBottom_toTopOf="@+id/guideline153"
        app:layout_constraintEnd_toStartOf="@+id/guideline146"
        app:layout_constraintHorizontal_bias="0.496"
